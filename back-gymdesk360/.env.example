# Copiar a .env y ajustar valores
DB_NAME=gymdesk360
DB_USER=gymdesk
DB_PASSWORD=cambiar_esto
APP_PORT=8084
SPRING_PROFILES_ACTIVE=default

# Seguridad (generar con: openssl rand -base64 48)
JWT_SECRET=cambiar_esto
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://demo-gymdesk.benzprojects.site
SWAGGER_ENABLED=true

# Demo: carga datos de ejemplo, habilita el login con un clic y reinicia todo cada noche.
# OJO: con DEMO_ENABLED=true la base se BORRA en cada reinicio. No usar con datos reales.
DEMO_ENABLED=true
